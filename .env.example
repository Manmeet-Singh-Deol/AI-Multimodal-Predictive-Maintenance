# ============================================
# AI Predictive Maintenance Assistant - Config
# ============================================

# Google Gemini API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db

# Database (Leave empty for built-in SQLite, or paste Supabase/PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend Settings
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO

# Data Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_MANUALS_DIR=./data/manuals
DATA_SYNTHETIC_DIR=./data/synthetic
MODELS_DIR=./models
